# Copy this file to .env and set strong, unique values.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=sadra_admin
ADMIN_PASSWORD=replace-with-a-unique-strong-password
# Set to 1 only behind a trusted HTTPS reverse proxy in production.
TRUST_PROXY=0
